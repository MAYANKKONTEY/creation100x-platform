# Copy to .env and fill in. Never commit .env.
APP_ENV=development
DATABASE_URL=sqlite:///./data/growthos.db
# PostgreSQL example: postgresql+psycopg://user:pass@host:5432/growthos

# Claude (required for triage/research/writing)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=high
# Server-side refusal fallback (recommended). Set false to disable.
CLAUDE_SERVER_FALLBACK=true

# OpenAI Images (Milestone 5)
OPENAI_API_KEY=

# LinkedIn (Milestone 7)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
TOKEN_ENCRYPTION_KEY=

# Publishing safety: BOTH this and the DB setting must be true to publish.
PUBLISHING_ENABLED=false

HTTP_USER_AGENT=LinkedInGrowthOS/0.1 (+research; contact via repository)
# IANA timezone used for scheduling, e.g. Europe/London
OWNER_TIMEZONE=UTC
